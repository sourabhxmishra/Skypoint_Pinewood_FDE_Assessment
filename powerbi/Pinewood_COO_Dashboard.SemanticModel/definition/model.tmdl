model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["GoldFolderPath","GoldFiles","dim_date","dim_community","dim_care_level","fact_resident_day","fact_occupancy_monthly","fact_lease","fact_incident","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_community
ref table dim_care_level
ref table fact_resident_day
ref table fact_occupancy_monthly
ref table fact_lease
ref table fact_incident
ref table _Measures

ref role 'Community Executive Director'
ref role 'Regional Director'

ref cultureInfo en-US

